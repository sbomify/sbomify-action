<?xml version="1.0" encoding="UTF-8"?>
<!--
  A small, self-contained Java project for the ecosystem matrix.

  The previous fixture was commons-lang3's own pom: it inherits an external
  parent and declares 7 test-scope and 1 provided-scope dependency, with
  nothing at compile scope. cdxgen is invoked with the flag that keeps only
  required dependencies, which strips exactly those, so the fixture reported 0 components and looked like
  a broken generator when the generator was correct.

  This one declares ordinary compile-scope dependencies with transitive
  closure of their own, which is what a real application looks like.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.sbomify.fixture</groupId>
  <artifactId>java-fixture</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.14.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>33.2.1-jre</version>
    </dependency>
  </dependencies>
</project>
