# Test files and data
tests/

# scripts/ is excluded except freeze_tool_versions.py, which the builder stage
# runs to resolve tools/go.mod and tools/Cargo.lock into literal versions
# before the wheel is built.
scripts/*
!scripts/freeze_tool_versions.py

# Git
.git/
.github/
.gitignore

# CI/CD configuration
.gitlab-ci.yml
bitbucket-pipelines.yml
pipe.yml

# Development files
.cursorrules
CLAUDE.md
.env
.pre-commit-config.yaml

# Build artifacts
dist/
build/
*.egg-info/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Documentation (README is needed for package metadata)
*.md
!README.md

# Misc
.DS_Store
Thumbs.db

# Dont include all sample SBOMs
tests/test-data
